# Copy this file to .env and change what you need. Every setting is optional
# in development; the defaults are shown.

# --- Server ---
# NODE_ENV=production
PORT=3001
# Used in links inside emails.
APP_URL=http://localhost:5173
DATABASE_FILE=server/data/lab-booking.db
# Required in production: a long random string (at least 32 characters).
# JWT_SECRET=
SESSION_HOURS=8

# --- HTTPS ---
# On Render/Railway/behind a reverse proxy, HTTPS is handled for you; keep
# FORCE_HTTPS=true so plain-HTTP visits are redirected. To serve HTTPS from
# this server directly, point these at a certificate and private key.
# FORCE_HTTPS=true
# HTTPS_CERT_FILE=certs/cert.pem
# HTTPS_KEY_FILE=certs/key.pem

# --- Email ---
# Without SMTP_HOST, emails are only written to the Email log page.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=AI Lab Booking <no-reply@example.com>
# Comma-separated. When empty, all lab assistant accounts get lab emails.
# LAB_ASSISTANT_EMAILS=

# --- Demo ---
# Shows the test accounts on the sign-in page (on by default outside production).
# DEMO_MODE=true
# Password given to every seeded test account.
SEED_PASSWORD=Password123
